# Salin ke .env lalu isi nilainya.

# Database Supabase. Untuk host deploy IPv4-only (mis. Render) pakai connection string
# Pooler port 6543, bukan Direct 5432.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Auth
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=24h

# App
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:5173
# Origin frontend yang diizinkan, pisahkan dengan koma.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase Storage (upload bukti bayar & QRIS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxx
SUPABASE_BUCKET_PROOF=booking-proofs
SUPABASE_BUCKET_PUBLIC=public-assets

# Notifikasi WhatsApp (opsional)
FONNTE_TOKEN=
